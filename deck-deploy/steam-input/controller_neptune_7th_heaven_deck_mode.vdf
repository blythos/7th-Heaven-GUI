	"localization"
	{
		"english"
		{
			"title"		"7th Heaven Deck mode"
			"description"		"Two action sets for the 7th Heaven Deck-mode fork. Launcher: buttons emit the keystrokes the Deck UI expects. Game: standard gamepad passthrough so FF7 and 7th Heaven's in-game controller code see the raw pad. Back grips (L4/L5/R4/R5) switch between the sets."
		}
	}

