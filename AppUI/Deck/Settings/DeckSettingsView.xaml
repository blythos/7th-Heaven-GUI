<UserControl x:Class="AppUI.Deck.Settings.DeckSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PrimaryAppBackground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding LevelTitle}"
                   FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryControlForeground}"
                   Margin="24,18,24,8"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- settings rows -->
            <ListBox x:Name="lstSettings"
                     Grid.Column="0"
                     ItemsSource="{Binding Rows}"
                     SelectedIndex="{Binding FocusedRowIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Focusable="False"
                     KeyboardNavigation.DirectionalNavigation="None"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     Margin="12,4,12,12"
                     SelectionChanged="lstSettings_SelectionChanged"
                     MouseDoubleClick="lstSettings_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="True"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="rowBorder"
                                            BorderThickness="2"
                                            BorderBrush="Transparent"
                                            Background="{DynamicResource PrimaryControlBackground}"
                                            Padding="16,12"
                                            Margin="0,2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource PrimaryControlMouseOver}"/>
                                        </Trigger>
                                        <!-- headers render flat with no row chrome -->
                                        <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                            <Setter TargetName="rowBorder" Property="Background" Value="Transparent"/>
                                            <Setter TargetName="rowBorder" Property="Padding" Value="16,18,16,4"/>
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.IsContentFocused, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.IsValuePanelOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="rowBorder" Property="BorderBrush" Value="{DynamicResource DeckAccentBrush}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.IsContentFocused, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource PrimaryControlMouseOver}"/>
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- headers are captions, not clickable rows -->
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="rowName"
                                       Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PrimaryControlForeground}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- toggle pill -->
                                <Border x:Name="togglePill" CornerRadius="12" Padding="14,4"
                                        Background="{DynamicResource PrimaryControlPressed}"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="TogglePill_MouseLeftButtonUp"
                                        Visibility="Collapsed">
                                    <TextBlock Text="{Binding DisplayValue}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryControlForeground}"/>
                                </Border>

                                <!-- value text (choice, stepper, text) -->
                                <TextBlock x:Name="valueText"
                                           Text="{Binding DisplayValue}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryControlSecondary}"
                                           Visibility="Collapsed"/>

                                <TextBlock x:Name="chevron"
                                           Text="›"
                                           FontSize="18"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryControlSecondary}"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter TargetName="rowName" Property="FontSize" Value="13"/>
                                <Setter TargetName="rowName" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="rowName" Property="Foreground" Value="{DynamicResource PrimaryControlSecondary}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToggle}" Value="True">
                                <Setter TargetName="togglePill" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="togglePill" Property="Background" Value="{DynamicResource DeckAccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChoice}" Value="True">
                                <Setter TargetName="valueText" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStepper}" Value="True">
                                <Setter TargetName="valueText" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsText}" Value="True">
                                <Setter TargetName="valueText" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLargeChoice}" Value="True">
                                <Setter TargetName="chevron" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAction}" Value="True">
                                <Setter TargetName="chevron" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" Background="{DynamicResource PrimaryControlPressed}"/>

            <!-- right pane: description, value picker, or text editor -->
            <Grid Grid.Column="2">
                <StackPanel Margin="24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValuePanelOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTextOverlayOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding FocusedRow.Name}"
                               FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryControlForeground}"/>
                    <TextBlock Text="{Binding FocusedRow.Description}"
                               FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{DynamicResource PrimaryControlSecondary}"/>
                </StackPanel>

                <!-- choice picker panel -->
                <ListBox x:Name="lstValues"
                         ItemsSource="{Binding ValueChoices}"
                         SelectedIndex="{Binding FocusedValueIndex, Mode=TwoWay}"
                         Visibility="{Binding IsValuePanelOpen, Converter={StaticResource BoolToVis}}"
                         Background="Transparent"
                         BorderThickness="0"
                         Focusable="False"
                         KeyboardNavigation.DirectionalNavigation="None"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         Margin="16"
                         SelectionChanged="lstValues_SelectionChanged"
                         MouseDoubleClick="lstValues_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="rowBorder"
                                                BorderThickness="2"
                                                BorderBrush="Transparent"
                                                Background="{DynamicResource PrimaryControlBackground}"
                                                Padding="14,10"
                                                Margin="0,2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource PrimaryControlMouseOver}"/>
                                        </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="rowBorder" Property="BorderBrush" Value="{DynamicResource DeckAccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryControlForeground}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- keyboard-fallback text editor -->
                <StackPanel Margin="24"
                            Visibility="{Binding IsTextOverlayOpen, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding FocusedRow.Name}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryControlForeground}"/>
                    <TextBox x:Name="txtValue"
                             Text="{Binding TextDraft, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15"
                             Margin="0,12,0,0"
                             Padding="8,6"
                             Background="{DynamicResource PrimaryControlBackground}"
                             Foreground="{DynamicResource PrimaryControlForeground}"
                             BorderBrush="{DynamicResource DeckAccentBrush}"
                             BorderThickness="2"
                             CaretBrush="{DynamicResource PrimaryControlForeground}"/>
                    <TextBlock Text="Type with a physical keyboard. On Deck press Steam + X."
                               FontSize="12" TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource PrimaryControlSecondary}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
