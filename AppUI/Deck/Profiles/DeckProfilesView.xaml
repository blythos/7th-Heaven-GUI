<UserControl x:Class="AppUI.Deck.Profiles.DeckProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PrimaryAppBackground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- profile list -->
        <ListBox x:Name="lstProfiles"
                 Grid.Column="0"
                 ItemsSource="{Binding Rows}"
                 SelectedIndex="{Binding FocusedProfileIndex, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 Focusable="False"
                 KeyboardNavigation.DirectionalNavigation="None"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch"
                 Margin="12,24,12,12"
                 SelectionChanged="lstProfiles_SelectionChanged"
                 MouseDoubleClick="lstProfiles_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="True"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="rowBorder"
                                        BorderThickness="2"
                                        BorderBrush="Transparent"
                                        Background="{DynamicResource PrimaryControlBackground}"
                                        Padding="16,12"
                                        Margin="0,2">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource PrimaryControlMouseOver}"/>
                                        </Trigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                            <Condition Binding="{Binding DataContext.IsContentFocused, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="rowBorder" Property="BorderBrush" Value="{DynamicResource DeckAccentBrush}"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                            <Condition Binding="{Binding DataContext.IsContentFocused, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource PrimaryControlMouseOver}"/>
                                    </MultiDataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource PrimaryControlForeground}"/>

                        <Border x:Name="currentBadge"
                                Grid.Column="1" CornerRadius="10" Padding="10,3"
                                VerticalAlignment="Center"
                                Background="{DynamicResource DeckAccentBrush}"
                                Visibility="Collapsed">
                            <TextBlock Text="Current" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#1A1A18"/>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="currentBadge" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" Background="{DynamicResource PrimaryControlPressed}"/>

        <!-- right pane: details, action panel, name editor, or delete confirm -->
        <Grid Grid.Column="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFocusedProfile}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActionPanelOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTextOverlayOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsConfirmOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="24">
                    <TextBlock Text="{Binding FocusedProfile.Name}"
                               FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryControlForeground}"/>

                    <TextBlock Text="Active mods" FontSize="14" Margin="0,18,0,6"
                               Foreground="{DynamicResource PrimaryControlSecondary}"/>

                    <TextBlock Text="{Binding FocusedProfile.DetailsText}"
                               FontSize="15" LineHeight="24"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryControlForeground}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- profile actions -->
            <StackPanel Margin="16,24"
                        Visibility="{Binding IsActionPanelOpen, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding FocusedProfile.Name}"
                           FontSize="18" FontWeight="SemiBold" Margin="8,0,8,10" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryControlForeground}"/>
                <ListBox x:Name="lstActions"
                         ItemsSource="{Binding ActionLabels}"
                         SelectedIndex="{Binding FocusedActionIndex, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Focusable="False"
                         KeyboardNavigation.DirectionalNavigation="None"
                         HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="lstActions_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="True"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="rowBorder"
                                                BorderThickness="2"
                                                BorderBrush="Transparent"
                                                Background="{DynamicResource PrimaryControlBackground}"
                                                Padding="14,10"
                                                Margin="0,2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource PrimaryControlMouseOver}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="rowBorder" Property="BorderBrush" Value="{DynamicResource DeckAccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="15"
                                       Foreground="{DynamicResource PrimaryControlForeground}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- profile name editor -->
            <StackPanel Margin="24"
                        Visibility="{Binding IsTextOverlayOpen, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding TextPrompt}"
                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryControlForeground}"/>
                <TextBox x:Name="txtProfileName"
                         Text="{Binding TextDraft, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="15"
                         Margin="0,12,0,0"
                         Padding="8,6"
                         Background="{DynamicResource PrimaryControlBackground}"
                         Foreground="{DynamicResource PrimaryControlForeground}"
                         BorderBrush="{DynamicResource DeckAccentBrush}"
                         BorderThickness="2"
                         CaretBrush="{DynamicResource PrimaryControlForeground}"/>
                <TextBlock Text="Type with a physical keyboard. On Deck press Steam + X."
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource PrimaryControlSecondary}"/>
            </StackPanel>

            <!-- confirm (delete / overwrite) -->
            <StackPanel Margin="24" VerticalAlignment="Center"
                        Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ConfirmText}"
                           FontSize="17" TextWrapping="Wrap"
                           Foreground="{DynamicResource PrimaryControlForeground}"/>
                <TextBlock Text="{Binding ConfirmHint}" Margin="0,12,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource PrimaryControlSecondary}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
