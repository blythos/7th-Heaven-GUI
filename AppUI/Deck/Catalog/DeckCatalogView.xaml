<UserControl x:Class="AppUI.Deck.Catalog.DeckCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:deck="clr-namespace:AppUI.Deck"
             Background="{DynamicResource PrimaryAppBackground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <deck:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToCollapsed"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- category column -->
        <Grid Grid.Column="0">
            <ListBox x:Name="lstCategories"
                     ItemsSource="{Binding Categories}"
                     SelectedIndex="{Binding FocusedCategoryIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Focusable="False"
                     KeyboardNavigation.DirectionalNavigation="None"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     Margin="8,24,8,8"
                     SelectionChanged="lstCategories_SelectionChanged"
                     PreviewMouseLeftButtonDown="lstCategories_PreviewMouseLeftButtonDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="True"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="rowBorder"
                                            BorderThickness="2"
                                            BorderBrush="{DynamicResource DeckPanelBorderBrush}"
                                            Background="Transparent"
                                            Padding="14,10"
                                            Margin="0,2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource PrimaryControlMouseOver}"/>
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.IsCategoryColumnFocused, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="rowBorder" Property="BorderBrush" Value="{DynamicResource DeckAccentBrush}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.IsCategoryColumnFocused, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource PrimaryControlMouseOver}"/>
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="15"
                                       Foreground="{DynamicResource PrimaryControlForeground}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ModCount}"
                                       FontSize="13"
                                       Margin="8,0,0,0"
                                       Foreground="{DynamicResource PrimaryControlSecondary}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="No catalog loaded. Add a catalog subscription in settings."
                       FontSize="14" TextWrapping="Wrap" Margin="20"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource PrimaryControlSecondary}"
                       Visibility="{Binding IsCatalogEmpty, Converter={StaticResource BoolToVis}}"/>

            <!-- search overlay slides over the category column -->
            <Border Background="{DynamicResource SecondaryAppBackground}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource PrimaryControlPressed}"
                    VerticalAlignment="Top"
                    Padding="16"
                    Visibility="{Binding IsSearchOverlayOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Search catalog"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryControlForeground}"/>
                    <TextBox x:Name="txtSearch"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15"
                             Margin="0,10,0,0"
                             Padding="8,6"
                             Background="{DynamicResource PrimaryControlBackground}"
                             Foreground="{DynamicResource PrimaryControlForeground}"
                             BorderBrush="{DynamicResource DeckAccentBrush}"
                             BorderThickness="2"
                             CaretBrush="{DynamicResource PrimaryControlForeground}"/>
                    <TextBlock Text="Type with a physical keyboard. On Deck press Steam + X."
                               FontSize="12" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource PrimaryControlSecondary}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource PrimaryControlPressed}"/>

        <!-- mods in the selected category / search results -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding ModsHeader}"
                       FontSize="18" FontWeight="SemiBold"
                       Margin="24,20,24,4"
                       Foreground="{DynamicResource PrimaryControlForeground}"/>

            <ListBox x:Name="lstCatalogMods"
                     Grid.Row="1"
                     ItemsSource="{Binding Mods}"
                     SelectedIndex="{Binding FocusedModIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Focusable="False"
                     KeyboardNavigation.DirectionalNavigation="None"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     Margin="12,8,12,12"
                     SelectionChanged="lstCatalogMods_SelectionChanged"
                     PreviewMouseLeftButtonDown="lstCatalogMods_PreviewMouseLeftButtonDown"
                     MouseDoubleClick="lstCatalogMods_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="True"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="rowBorder"
                                            BorderThickness="2"
                                            BorderBrush="{DynamicResource DeckPanelBorderBrush}"
                                            Background="{DynamicResource PrimaryControlBackground}"
                                            Padding="16,10"
                                            Margin="0,2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource PrimaryControlMouseOver}"/>
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.IsModColumnFocused, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="rowBorder" Property="BorderBrush" Value="{DynamicResource DeckAccentBrush}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.IsModColumnFocused, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource PrimaryControlMouseOver}"/>
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="16"
                                           Foreground="{DynamicResource PrimaryControlForeground}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="13"
                                           Foreground="{DynamicResource PrimaryControlSecondary}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Author, Mode=OneWay}"/> · <Run Text="{Binding DownloadSize, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <Border x:Name="installedBadge"
                                    Grid.Column="1" CornerRadius="10" Padding="10,3"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource PrimaryControlPressed}"
                                    Visibility="Collapsed">
                                <TextBlock Text="Installed" FontSize="12"
                                           Foreground="{DynamicResource PrimaryControlForeground}"/>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                <Setter TargetName="installedBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Column="3" Background="{DynamicResource PrimaryControlPressed}"/>

        <!-- details pane -->
        <Grid Grid.Column="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasFocusedCatalogMod, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="24">
                    <TextBlock Text="{Binding FocusedCatalogMod.Name}"
                               FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryControlForeground}"/>

                    <TextBlock Text="Author" FontSize="14" Margin="0,18,0,0"
                               Foreground="{DynamicResource PrimaryControlSecondary}"/>
                    <TextBlock Text="{Binding FocusedCatalogMod.Author}" FontSize="16" Margin="0,2,0,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryControlForeground}"/>

                    <TextBlock Text="Version" FontSize="14"
                               Foreground="{DynamicResource PrimaryControlSecondary}"/>
                    <TextBlock Text="{Binding FocusedCatalogMod.Version}" FontSize="16" Margin="0,2,0,10"
                               Foreground="{DynamicResource PrimaryControlForeground}"/>

                    <TextBlock Text="Category" FontSize="14"
                               Foreground="{DynamicResource PrimaryControlSecondary}"/>
                    <TextBlock Text="{Binding FocusedCatalogMod.Category}" FontSize="16" Margin="0,2,0,10"
                               Foreground="{DynamicResource PrimaryControlForeground}"/>

                    <TextBlock Text="Download size" FontSize="14"
                               Foreground="{DynamicResource PrimaryControlSecondary}"/>
                    <TextBlock Text="{Binding FocusedCatalogMod.DownloadSize}" FontSize="16" Margin="0,2,0,10"
                               Foreground="{DynamicResource PrimaryControlForeground}"/>

                    <TextBlock Text="Release date" FontSize="14"
                               Foreground="{DynamicResource PrimaryControlSecondary}"/>
                    <TextBlock Text="{Binding FocusedCatalogMod.ReleaseDate}" FontSize="16" Margin="0,2,0,14"
                               Foreground="{DynamicResource PrimaryControlForeground}"/>

                    <Image Source="{Binding FocusedModImageSource}"
                           MaxHeight="280"
                           StretchDirection="DownOnly"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,14"/>

                    <TextBlock Text="{Binding FocusedCatalogMod.Mod.Description}"
                               FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryControlSecondary}"/>

                    <TextBlock Text="Release notes" FontSize="14" Margin="0,16,0,0"
                               Foreground="{DynamicResource PrimaryControlSecondary}"
                               Visibility="{Binding FocusedModReleaseNotes, Converter={StaticResource NullOrEmptyToCollapsed}}"/>
                    <TextBlock Text="{Binding FocusedModReleaseNotes}"
                               FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource PrimaryControlSecondary}"
                               Visibility="{Binding FocusedModReleaseNotes, Converter={StaticResource NullOrEmptyToCollapsed}}"/>

                    <TextBlock Text="{Binding FocusedModLink}"
                               FontSize="14" TextWrapping="Wrap" Margin="0,16,0,0"
                               Cursor="Hand"
                               TextDecorations="Underline"
                               Foreground="{DynamicResource DeckAccentBrush}"
                               Visibility="{Binding FocusedModLink, Converter={StaticResource NullOrEmptyToCollapsed}}"
                               MouseLeftButtonUp="ModLink_MouseLeftButtonUp"/>
                </StackPanel>
            </ScrollViewer>

            <!-- active downloads strip -->
            <ItemsControl ItemsSource="{Binding CatalogSource.DownloadList}"
                          VerticalAlignment="Bottom"
                          Margin="16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SecondaryAppBackground}"
                                Padding="12,8" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding ItemName}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource PrimaryControlForeground}"/>
                                <ProgressBar Value="{Binding PercentComplete, Mode=OneWay}" Maximum="100"
                                             Height="4" Margin="0,6,0,0"
                                             Background="{DynamicResource PrimaryControlPressed}"
                                             Foreground="{DynamicResource DeckAccentBrush}"
                                             BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
