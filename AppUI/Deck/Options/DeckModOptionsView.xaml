<UserControl x:Class="AppUI.Deck.Options.DeckModOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PrimaryAppBackground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding LevelTitle}"
                   FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryControlForeground}"
                   Margin="28,20"/>

        <Border Grid.Row="1" Background="{DynamicResource PrimaryControlPressed}"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- option rows -->
            <ListBox x:Name="lstOptions"
                     Grid.Column="0"
                     ItemsSource="{Binding Rows}"
                     SelectedIndex="{Binding FocusedRowIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Focusable="False"
                     KeyboardNavigation.DirectionalNavigation="None"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     Margin="16,16,16,16"
                     SelectionChanged="lstOptions_SelectionChanged">
            <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="rowBorder"
                                            BorderThickness="2"
                                            BorderBrush="Transparent"
                                            Background="{DynamicResource PrimaryControlBackground}"
                                            Padding="16,12"
                                            Margin="0,2">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.IsValuePanelOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="rowBorder" Property="BorderBrush" Value="{DynamicResource DeckAccentBrush}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.IsValuePanelOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource PrimaryControlMouseOver}"/>
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PrimaryControlForeground}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- bool: toggle pill -->
                                <Border x:Name="boolPill" CornerRadius="12" Padding="14,4"
                                        Background="{DynamicResource PrimaryControlPressed}"
                                        Visibility="Collapsed">
                                    <TextBlock Text="{Binding DisplayValue}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryControlForeground}"/>
                                </Border>

                                <!-- list: current value + chevron -->
                                <TextBlock x:Name="listValue"
                                           Text="{Binding DisplayValue}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryControlSecondary}"
                                           Visibility="Collapsed"/>

                                <TextBlock x:Name="chevron"
                                           Text="›"
                                           FontSize="18"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryControlSecondary}"
                                           Visibility="Collapsed"/>

                                <TextBlock x:Name="lockedHint"
                                           Text="Locked"
                                           FontSize="12"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryControlDisabledForeground}"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsBool}" Value="True">
                                <Setter TargetName="boolPill" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="boolPill" Property="Background" Value="{DynamicResource DeckAccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsList}" Value="True">
                                <Setter TargetName="listValue" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLargeList}" Value="True">
                                <Setter TargetName="chevron" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                <Setter TargetName="chevron" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter TargetName="lockedHint" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" Background="{DynamicResource PrimaryControlPressed}"/>

            <!-- right pane: description/preview, or the value picker when open -->
            <Grid Grid.Column="2">
                <StackPanel Margin="24">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValuePanelOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="{Binding Config.CompatibilityNote}"
                               FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource DeckAccentBrush}"
                               Margin="0,0,0,12"/>

                    <Image Source="{Binding Config.ImageOptionSource}"
                           MaxHeight="240"
                           StretchDirection="DownOnly"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,14"/>

                    <TextBlock Text="{Binding Config.Description}"
                               FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryControlSecondary}"/>
                </StackPanel>

                <ListBox x:Name="lstValues"
                         ItemsSource="{Binding ValueChoices}"
                         SelectedIndex="{Binding FocusedValueIndex, Mode=TwoWay}"
                         Visibility="{Binding IsValuePanelOpen, Converter={StaticResource BoolToVis}}"
                         Background="Transparent"
                         BorderThickness="0"
                         Focusable="False"
                         KeyboardNavigation.DirectionalNavigation="None"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         Margin="16"
                         SelectionChanged="lstValues_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="rowBorder"
                                                BorderThickness="2"
                                                BorderBrush="Transparent"
                                                Background="{DynamicResource PrimaryControlBackground}"
                                                Padding="14,10"
                                                Margin="0,2">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="rowBorder" Property="BorderBrush" Value="{DynamicResource DeckAccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ValueName}"
                                       FontSize="14"
                                       Foreground="{DynamicResource PrimaryControlForeground}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
